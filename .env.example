# Compose-level shared values — read by docker-compose.yml itself (for the
# Postgres container's own required env vars) AND passed through to the
# backend container so both sides agree on the same database credentials.
#
# Everything else the app needs (API keys, JWT secret, SMTP, etc.) stays in
# backend/.env — copy backend/.env.example there and fill it in separately.
#
# Copy this file to ".env" (same directory as docker-compose.yml) and edit it
# before running `docker compose up`.

# Names the compose project (container/network/volume prefix). Defaults to the
# directory name if unset — set it explicitly so the stack is "tolkyn_*"
# regardless of what the checkout folder is called.
COMPOSE_PROJECT_NAME=tolkyn

DB_NAME=tolkyn
DB_USER=tolkyn
DB_PASSWORD=change-me-to-a-real-password

# Used only for the Postgres/Redis internal ports if you ever need to expose
# them to the host for a one-off `psql`/`redis-cli` session — leave commented
# out otherwise so they stay reachable only from inside the compose network.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Baked into the frontend's client bundle at BUILD time (Next.js inlines
# NEXT_PUBLIC_* vars) — the public URL browsers will call your API on.
NEXT_PUBLIC_API_URL=https://tolkyn.co.ke/api/v1

# Shared secret authenticating backend <-> whatsapp-worker calls. Must match
# the same value in backend/.env exactly — generate with `openssl rand -hex 24`.
INTERNAL_SHARED_SECRET=change-me-to-a-real-random-value

# ── Call centre — Asterisk PBX + Cloud One SIP trunk ─────────────────────
# One shared trunk account (Tolkyn is the reseller). Read by the asterisk
# container in docker-compose.yml.
CLOUDONE_SIP_HOST=LS02.CLOUDONE.CO.KE
CLOUDONE_SIP_USER=ittqaniyun_poc
CLOUDONE_SIP_PASSWORD=            # from Cloud One (WhatsApp) — required
CLOUDONE_DID=254207901958         # the POC DID
PBX_PUBLIC_IP=38.242.200.152      # this VPS's public IP (RTP audio target)
SOFTPHONE_EXT=1001                # the agent extension for the POC
SOFTPHONE_EXT_PASSWORD=           # generate: openssl rand -hex 16 — required
PBX_WS_PORT=8188                  # Asterisk WS bind (127.0.0.1); nginx proxies /ws to it

# TURN relay (coturn) — carries WebRTC audio when a direct browser<->PBX path fails
PBX_TURN_URL=turn:38.242.200.152:3478    # turn:<PBX_PUBLIC_IP>:3478
PBX_TURN_USER=tolkyn
PBX_TURN_PASSWORD=                # generate: openssl rand -hex 20 — required

# Call-event bridge (asterisk/ami-bridge.py) — real call state in the Call
# Center (timer starts on answer, card clears on remote hangup, missed calls).
# install-on-host.sh reads these; the backend also needs PBX_EVENT_WEBHOOK_SECRET
# (passed through by docker-compose).
PBX_AMI_USER=tolkyn-bridge
PBX_AMI_PASSWORD=                 # generate: openssl rand -hex 20 — required for the bridge
PBX_EVENT_WEBHOOK_SECRET=         # generate: openssl rand -hex 20 — required for the bridge
PBX_EVENT_WORKSPACE_ID=_default   # "_default" = the one workspace whose provider is asterisk
PBX_EVENT_BACKEND_URL=http://127.0.0.1:8090/api/v1
