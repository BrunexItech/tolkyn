# Compose-level shared values — read by docker-compose.yml itself (for the
# Postgres container's own required env vars) AND passed through to the
# backend container so both sides agree on the same database credentials.
#
# Everything else the app needs (API keys, JWT secret, SMTP, etc.) stays in
# backend/.env — copy backend/.env.example there and fill it in separately.
#
# Copy this file to ".env" (same directory as docker-compose.yml) and edit it
# before running `docker compose up`.

# Names the compose project (container/network/volume prefix). Defaults to the
# directory name if unset — set it explicitly so the stack is "tolkyn_*"
# regardless of what the checkout folder is called.
COMPOSE_PROJECT_NAME=tolkyn

DB_NAME=tolkyn
DB_USER=tolkyn
DB_PASSWORD=change-me-to-a-real-password

# Used only for the Postgres/Redis internal ports if you ever need to expose
# them to the host for a one-off `psql`/`redis-cli` session — leave commented
# out otherwise so they stay reachable only from inside the compose network.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Baked into the frontend's client bundle at BUILD time (Next.js inlines
# NEXT_PUBLIC_* vars) — the public URL browsers will call your API on.
NEXT_PUBLIC_API_URL=https://tolkyn.co.ke/api/v1

# Shared secret authenticating backend <-> whatsapp-worker calls. Must match
# the same value in backend/.env exactly — generate with `openssl rand -hex 24`.
INTERNAL_SHARED_SECRET=change-me-to-a-real-random-value
