# Copy this file to ".env" in this same directory and fill in real values.
# Never commit the real .env — it's already in .gitignore.
#
# Settings with no line here fall back to the default in app/core/config.py.

# ── App ────────────────────────────────────────────────────────────────
APP_NAME=Tolkyn
APP_VERSION=1.0.0
# development | staging | production — production turns on TrustedHostMiddleware
# (see ALLOWED_HOSTS below) and the HSTS security header.
APP_ENV=production
# MUST be false in production — true exposes /docs, /redoc and /openapi.json,
# and turns on verbose SQL query logging.
DEBUG=false
API_V1_PREFIX=/api/v1

# ── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Real worker-process concurrency is set on the Docker CMD (gunicorn
# --workers), not here — see backend/Dockerfile and WEB_CONCURRENCY below.
WEB_CONCURRENCY=2

# ── Background scheduler (publishes due posts, runs automations, sweeps
# social-lead classification) — safe to leave on even with multiple API
# replicas; a Redis-backed lock (app/core/scheduler_lock.py) elects a single
# leader among them automatically. ──
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ── Database — in docker-compose these host/port point at the "postgres"
# service by name, not localhost. DB_NAME/DB_USER/DB_PASSWORD should match
# the root .env.example values used to provision the Postgres container. ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tolkyn
DB_USER=tolkyn
DB_PASSWORD=change-me-to-a-real-password
# Per-process pool. Total real Postgres connections = (replicas × workers) ×
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) — keep this under Postgres's max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Security ───────────────────────────────────────────────────────────
# MUST be a long random value in production (`openssl rand -hex 32`) — this
# signs every JWT. Rotating it invalidates every logged-in session.
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Super admin (platform control room, separate from tenant accounts) ──
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ── CORS / hosts — set these to your real domain in production, not "*" ──
ALLOWED_ORIGINS=https://tolkyn.co.ke,https://www.tolkyn.co.ke
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
ALLOWED_HOSTS=tolkyn.co.ke,www.tolkyn.co.ke

# ── Rate limiting (per client IP) ──
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_AUTH=10/minute

# ── Redis (rate limiting + scheduler leader lock) — "redis" is the
# docker-compose service name, not localhost, inside the compose network. ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Platform email (Tolkyn-brand) — password resets, email verification,
# team invites and super-admin announcements all send through this. With a
# Gmail account use an App Password (Google account → Security → App
# passwords), not the normal password. Leave blank to fall back to copyable
# links instead of sending real mail.
# Gmail caps: ~500 recipients/day (free) or ~2000/day (Workspace). For higher
# volume, point these at a transactional provider (SES / SendGrid / Mailgun) —
# no code change, just SMTP host/port/credentials. ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tolkyn.co.ke
SMTP_FROM_NAME=Tolkyn

# ── Public URL of the frontend — used to build invite links, OAuth
# redirects and email links (password reset, verification). Must be the real
# public domain, not an internal Docker service name. ──
FRONTEND_URL=https://tolkyn.co.ke

# ── Public URL of this backend — used to build webhook URLs handed to third
# parties (e.g. the per-workspace PBX event webhook shown in the super-admin
# Telephony page). Real public domain, not an internal service name. ──
BACKEND_PUBLIC_URL=https://tolkyn.co.ke

# ── AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=

# ── Geo targeting (optional — keyless OpenStreetMap/Nominatim if blank) ──
GEOAPIFY_API_KEY=

# ── Media Intelligence live search (optional; Tavily recommended for
# reliability over the keyless DuckDuckGo scrape fallback) ──
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Social publishing / account connections (Upload-Post) ──
UPLOAD_POST_API_KEY=

# ── Messaging: Bulk SMS (Mobile Sasa primary, Twilio fallback) — simulated
# if both are blank ──
MOBILESASA_TOKEN=
MOBILESASA_SENDER_ID=MOBILESASA
MOBILESASA_BASE_URL=https://api.mobilesasa.com
DEFAULT_COUNTRY_CODE=+254
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# ── Messaging: WhatsApp Cloud API (Meta) — simulated if blank ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Messaging: self-hosted WhatsApp Web sessions (Baileys worker) — the
# unofficial, at-your-own-risk channel while waiting on real Cloud API
# access. "whatsapp-worker" is the docker-compose service name; must match
# INTERNAL_SHARED_SECRET in the root .env exactly. ──
WHATSAPP_WORKER_URL=http://whatsapp-worker:4001
INTERNAL_SHARED_SECRET=change-me-to-a-real-random-value
