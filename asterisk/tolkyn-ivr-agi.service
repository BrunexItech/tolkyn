[Unit]
Description=Tolkyn PBX -> real-call IVR bridge (FastAGI server)
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
EnvironmentFile=/etc/tolkyn/ami-bridge.env
ExecStart=/usr/bin/python3 /opt/tolkyn/ivr_agi.py
Restart=always
RestartSec=3
User=asterisk
Group=asterisk
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/tolkyn
ReadWritePaths=/usr/share/asterisk/sounds

[Install]
WantedBy=multi-user.target
