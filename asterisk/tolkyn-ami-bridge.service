[Unit]
Description=Tolkyn PBX -> backend call-event bridge (AMI)
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
# EnvironmentFile is written by install-on-host.sh from the repo-root .env
EnvironmentFile=/etc/tolkyn/ami-bridge.env
ExecStart=/usr/bin/python3 /opt/tolkyn/ami-bridge.py
Restart=always
RestartSec=3
User=asterisk
Group=asterisk
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/tolkyn
# Voice Broadcast fetches rendered TTS audio onto this host before
# originating each call (see _voice_broadcast_loop in ami-bridge.py) --
# same directory, same exception tolkyn-ivr-agi.service already carries
# for the identical IVR-prompt use case. Everything else stays read-only
# under ProtectSystem=strict; this is the one path that needs a write.
ReadWritePaths=/usr/share/asterisk/sounds

[Install]
WantedBy=multi-user.target
