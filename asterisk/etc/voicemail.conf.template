[general]
format = wav49|wav
maxmsg = 100
maxsecs = 180
minsecs = 2
maxsilence = 5
sendvoicemail = no
attach = no
; posts each new message (audio + caller info) to the Tolkyn backend so it
; shows up in the Call Center — see voicemail-notify.sh. No-ops safely if the
; call-event bridge isn't configured.
externnotify = /opt/tolkyn/voicemail-notify.sh

[default]
; One mailbox per workspace's agent extension — generated + kept in sync by
; asterisk/sync_workspaces.py, same mechanism as pjsip_workspaces.conf.
#include voicemail_workspaces.conf
