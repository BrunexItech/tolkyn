;======================================================================
; Tolkyn PBX dialplan. Cloud One's numbering rules (article 109):
;   inbound  — normalise caller ID to +254XXXXXXXXX (E.164)
;   outbound — Kenya local in 0XXXXXXXXX form; international in +CC / E.164
;   caller ID on every outbound leg MUST be our DID (trunk authentication)
;
; Multi-tenant routing: one Cloud One trunk, many DIDs, many workspaces. The
; DID -> agent-extension map lives in Asterisk's built-in AstDB (family
; "tolkyn"), kept in sync with telephony_configs / call_agents by the host
; script asterisk/sync_workspaces.py (systemd timer). This dialplan never
; hardcodes a DID or an extension — it's rewritten once and never touched
; again when a new client is onboarded.
;
; AstDB keys (last 9 digits of the phone number, so the format Cloud One
; happens to send — with/without +254 — never matters):
;   tolkyn/did/<9digits>      -> agent extension  (inbound routing)
;   tolkyn/ext_did/<ext>      -> the workspace's DID, +254... (caller ID on an
;                                IVR "transfer" action; also informational)
;   tolkyn/ext_ws/<ext>       -> workspace_id (real-call IVR AGI bridge; also
;                                used by voicemail-notify.sh)
;   tolkyn/ext_record/<ext>   -> "1"/"0" — call recording on/off for that workspace
;
; Asterisk picks the MOST SPECIFIC matching pattern, so the +254 / 254 rules
; below win over the generic international ones for Kenyan numbers.
;======================================================================
[general]
static = yes
writeprotect = no
clearglobalvars = no

[globals]
RINGTIME = 25

;--- Inbound: Cloud One -> whichever DID was dialled -> that workspace's ---
;--- agent, else that workspace's voicemail. Unknown DID -> hang up: we   ---
;--- never guess which workspace an unmapped number belongs to.          ---
[from-cloudone]
; Goto(route,1) makes "route" the CURRENT extension, so ${EXTEN} inside it
; would read back as the literal string "route", not the number that was
; actually dialled — save it to a channel var first, before jumping away.
exten => _X.,1,Set(DIALED_DID=${EXTEN})
 same => n,Goto(route,1)
exten => s,1,Set(DIALED_DID=${EXTEN})
 same => n,Goto(route,1)

exten => route,1,NoOp(Inbound to ${DIALED_DID})
 same => n,Set(DNUM=${FILTER(0-9,${DIALED_DID})})
 same => n,Set(DNUM=${DNUM:-9})
 same => n,Set(WS_EXT=${DB(tolkyn/did/${DNUM})})
 same => n,GotoIf($["${WS_EXT}" = ""]?nodid,1)
 same => n,Goto(handle,1)

exten => nodid,1,NoOp(No workspace owns a DID ending ${DNUM} -- hanging up)
 same => n,Hangup()

exten => handle,1,NoOp(Inbound from ${CALLERID(num)} -> ext ${WS_EXT})
 same => n,Set(CNUM=${FILTER(0-9+,${CALLERID(num)})})
 same => n,ExecIf($["${CNUM:0:3}" = "254"]?Set(CNUM=+${CNUM}))
 same => n,ExecIf($["${CNUM:0:1}" = "0"]?Set(CNUM=+254${CNUM:1}))
 same => n,ExecIf($[${LEN(${CNUM})} = 9]?Set(CNUM=+254${CNUM}))
 same => n,Set(CALLERID(num)=${CNUM})
 ; Real-call IVR: hand off to the host-side FastAGI bridge (asterisk/ivr_agi.py)
 ; before ever dialing the agent. It plays this workspace's menu (if the IVR
 ; is even turned on — get_flow()/on_call_enter() decide that, not this
 ; dialplan) and sets IVR_NEXT to whatever the caller's choice resolved to.
 ; If the IVR is off, or the AGI service is down/unreachable for any reason,
 ; IVR_NEXT stays unset and every GotoIf below is skipped — falls straight
 ; through to the exact same ring-the-agent behaviour as before this existed.
 same => n,Set(WS_ID=${DB(tolkyn/ext_ws/${WS_EXT})})
 same => n,AGI(agi://127.0.0.1:4573/ivr,${WS_ID})
 same => n,GotoIf($["${IVR_NEXT}" = "voicemail"]?ivr-voicemail,1)
 same => n,GotoIf($["${IVR_NEXT}" = "ai_agent"]?ivr-ai-agent,1)
 same => n,GotoIf($["${IVR_NEXT}" = "transfer"]?ivr-transfer,1)
 same => n,GotoIf($["${IVR_NEXT}" = "hangup"]?ivr-hangup,1)
 ; call recording — opt-in per workspace (Super Admin -> Telephony ->
 ; Record calls), mirrored into AstDB by sync_workspaces.py. 'b' = only
 ; record once the call is actually bridged, not ring time.
 same => n,ExecIf($["${DB(tolkyn/ext_record/${WS_EXT})}" = "1"]?MixMonitor(/var/spool/asterisk/recordings/${LINKEDID}.wav,b))
 same => n,Dial(PJSIP/${WS_EXT},${RINGTIME},rtT)
 ; if the call actually connected (agent answered, then either side hung up)
 ; end it — don't dump the caller into voicemail.
 same => n,ExecIf($["${DIALSTATUS}" = "ANSWER"]?Hangup())
 same => n,VoiceMail(${WS_EXT}@default,u)
 same => n,Hangup()

exten => ivr-voicemail,1,VoiceMail(${WS_EXT}@default,u)
 same => n,Hangup()

exten => ivr-ai-agent,1,ExecIf($["${DB(tolkyn/ext_record/${WS_EXT})}" = "1"]?MixMonitor(/var/spool/asterisk/recordings/${LINKEDID}.wav,b))
 ; This leg dials one shared ElevenLabs SIP destination for every workspace,
 ; so caller_id/called_number on it are just the trunk's own static
 ; identity ("tolkynagent") -- useless for the conversation-init webhook to
 ; tell workspaces apart (confirmed via real-call logging). A custom X-
 ; header is how ElevenLabs' SIP trunking actually supports this: they
 ; strip the X- prefix, lowercase it, and expose it to the webhook -- so
 ; this becomes recoverable as the workspace's own id on their side.
 ;
 ; PJSIP_HEADER(add,...) only affects requests sent by the channel it's set
 ; on -- setting it here, on the INBOUND leg, does nothing to the separate
 ; OUTBOUND channel Dial() creates (confirmed via a raw SIP trace: the
 ; header never made it onto the actual INVITE). The b() option runs a
 ; Gosub on that new outbound channel itself, before it dials out, which is
 ; the only place PJSIP_HEADER actually takes effect for this leg. ${WS_ID}
 ; is evaluated here, on the calling channel, and handed over as ARG1 --
 ; it's a plain (non-inherited) channel var, so it wouldn't otherwise be
 ; visible on the new channel at all.
 same => n,Dial(PJSIP/${ELEVENLABS_SIP_USER}@elevenlabs,30,rtTb(add-workspace-header^s^1(${WS_ID})))
 same => n,Hangup()

exten => add-workspace-header,1,Set(PJSIP_HEADER(add,X-Workspace-Id)=${ARG1})
 same => n,Return()

; Reuses [from-internal]'s own number-normalisation patterns rather than
; duplicating them — ${DID} is the same channel var those patterns already
; expect for caller ID, just set from AstDB here instead of an agent
; endpoint's set_var (there's no agent endpoint on this leg, it's the caller).
exten => ivr-transfer,1,Set(DID=${DB(tolkyn/ext_did/${WS_EXT})})
 same => n,Goto(from-internal,${IVR_TARGET},1)

exten => ivr-hangup,1,Hangup()

exten => h,1,Hangup()

;--- Outbound: from an agent softphone -> Cloud One trunk. Caller ID is  ---
;--- ${DID}, a per-endpoint channel variable (set_var=DID=... on that    ---
;--- agent's PJSIP endpoint in pjsip_workspaces.conf) — so each workspace---
;--- always calls out as its own DID, never another workspace's.        ---
[from-internal]
; Call recording (same opt-in as inbound, see [from-cloudone]) applies to
; every outbound pattern below — one subroutine so it's only written once.
exten => rec-gate,1,ExecIf($["${DB(tolkyn/ext_record/${MYEXT})}" = "1"]?MixMonitor(/var/spool/asterisk/recordings/${LINKEDID}.wav,b))
 same => n,Return()

; Kenya: +254XXXXXXXXX -> 0XXXXXXXXX
exten => _+254XXXXXXXXX,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/0${EXTEN:4}@cloudone,60,rtT)
 same => n,Hangup()

; Kenya: 254XXXXXXXXX -> 0XXXXXXXXX
exten => _254XXXXXXXXX,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/0${EXTEN:3}@cloudone,60,rtT)
 same => n,Hangup()

; Kenya: already 0XXXXXXXXX (10 digits) -> send as-is
exten => _0XXXXXXXXX,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/${EXTEN}@cloudone,60,rtT)
 same => n,Hangup()

; Kenya: bare 9-digit local (7XXXXXXXX / 1XXXXXXXX) -> prefix 0
exten => _[17]XXXXXXXX,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/0${EXTEN}@cloudone,60,rtT)
 same => n,Hangup()

; International dialled as 000<CC>... -> +<CC>...
exten => _000X.,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/+${EXTEN:3}@cloudone,60,rtT)
 same => n,Hangup()

; International, already E.164 with a leading + -> send as-is
exten => _+X.,1,Set(CALLERID(num)=${DID})
 same => n,Gosub(rec-gate,1)
 same => n,Dial(PJSIP/${EXTEN}@cloudone,60,rtT)
 same => n,Hangup()

; voicemail access — ${MYEXT} is the calling agent's own extension, another
; per-endpoint set_var (same mechanism as ${DID} above).
exten => *97,1,VoiceMailMain(${MYEXT}@default)
 same => n,Hangup()

; manual test line for the ElevenLabs AI agent — dial *80 from any agent
; softphone to talk to it directly. Temporary, for proving the SIP trunk
; connection works before it's wired into any workspace's IVR.
exten => *80,1,Dial(PJSIP/${ELEVENLABS_SIP_USER}@elevenlabs,30,rtT)
 same => n,Hangup()

exten => h,1,Hangup()
