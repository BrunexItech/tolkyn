[general]
rtpstart = 10000
rtpend = 20000

; Accept RTP even from a source ICE hasn't fully validated (NAT hole-punch race).
strictrtp = no

; Asterisk runs on the host, which also has ~10 Docker bridge interfaces
; (172.x). Those must be kept out of ICE or pjproject's connectivity checks
; error ("Invalid argument"). Blacklist every private range so the only
; candidate offered is eth0's public IP — which, running natively, Asterisk
; sees directly as a host candidate (no NAT, no STUN needed).
icesupport = yes
ice_blacklist = 172.16.0.0/12
ice_blacklist = 10.0.0.0/8
ice_blacklist = 192.168.0.0/16
ice_blacklist = 169.254.0.0/16

; The trunk leg (plain SIP/UDP to Cloud One) uses external_media_address in
; pjsip.conf, not ICE.
