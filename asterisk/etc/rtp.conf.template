[general]
rtpstart = 10000
rtpend = 10100

; Accept RTP even from a source ICE hasn't fully validated — belt-and-braces
; for the WebRTC leg while NAT hole-punching settles.
strictrtp = no

; WebRTC (browser) legs use ICE. Asterisk is on its own single-interface
; bridge network now, so it gathers one host candidate (the container IP) plus
; a STUN reflexive candidate — which, because the RTP ports are published
; 1:1, resolves to this VPS's public IP. That reflexive candidate is the one
; the browser actually uses.
icesupport = yes
stunaddr = stun.l.google.com:19302
