; Asterisk's built-in HTTP server. Used only for the SIP-over-WebSocket
; endpoint (/ws) that the browser softphone (SIP.js) connects to.
;
; Plain HTTP on localhost — the host nginx terminates TLS on
; pbx.tolkyn.co.ke and proxies  wss://…/ws  ->  ws://127.0.0.1:${PBX_WS_PORT}/ws
[general]
enabled = yes
; 0.0.0.0 so Docker's port publish can reach it — the compose file only
; exposes this on the host's 127.0.0.1:8188, so it is not internet-facing.
bindaddr = 0.0.0.0
bindport = ${PBX_WS_PORT}
sessionlimit = 200
session_inactivity = 30000
session_keep_alive = 15000
