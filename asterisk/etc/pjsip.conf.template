;======================================================================
; Tolkyn PBX — Cloud One SIP trunk + one WebRTC softphone extension.
; Rendered from pjsip.conf.template by entrypoint.sh.
;======================================================================

;--- Transports --------------------------------------------------------
[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060
; SDP toward Cloud One / the browser must carry this VPS's public IP, not the
; container's bridge address.
external_media_address = ${PBX_PUBLIC_IP}
external_signaling_address = ${PBX_PUBLIC_IP}
local_net = 10.0.0.0/8
local_net = 172.16.0.0/12
local_net = 192.168.0.0/16
local_net = 127.0.0.0/8

; the browser softphone connects here. nginx terminates TLS on
; pbx.tolkyn.co.ke and proxies to Asterisk's plain-ws HTTP server (http.conf),
; so this transport is 'ws', not 'wss'. The real listening socket is
; http.conf's (127.0.0.1:${PBX_WS_PORT}) — a 'ws'/'wss' pjsip transport never
; opens its own socket. 'bind' here is NOT a listener; Asterisk copies it onto
; the RTP media socket for calls on this transport, so it MUST be 0.0.0.0 —
; 127.0.0.1 binds the audio socket to loopback while SDP still advertises the
; public IP, and every call is silent (browser media hits a dead port).
[transport-ws]
type = transport
protocol = ws
bind = 0.0.0.0
external_media_address = ${PBX_PUBLIC_IP}
external_signaling_address = ${PBX_PUBLIC_IP}
local_net = 127.0.0.0/8

; TCP, for the ElevenLabs trunk below — their "Allowed Source IP Addresses"
; restriction only takes effect over TCP/TLS, not UDP, so this is what makes
; that IP allowlist actually mean something.
[transport-tcp]
type = transport
protocol = tcp
bind = 0.0.0.0:5060
external_media_address = ${PBX_PUBLIC_IP}
external_signaling_address = ${PBX_PUBLIC_IP}
local_net = 10.0.0.0/8
local_net = 172.16.0.0/12
local_net = 192.168.0.0/16
local_net = 127.0.0.0/8

;--- Cloud One trunk -------------------------------------------------
[cloudone_auth]
type = auth
auth_type = userpass
username = ${CLOUDONE_SIP_USER}
password = ${CLOUDONE_SIP_PASSWORD}

[cloudone_aor]
type = aor
contact = sip:${CLOUDONE_SIP_HOST}
qualify_frequency = 60

[cloudone_reg]
type = registration
transport = transport-udp
outbound_auth = cloudone_auth
server_uri = sip:${CLOUDONE_SIP_HOST}
client_uri = sip:${CLOUDONE_SIP_USER}@${CLOUDONE_SIP_HOST}
retry_interval = 30
forbidden_retry_interval = 300
fatal_retry_interval = 300
expiration = 300
line = yes
endpoint = cloudone

[cloudone]
type = endpoint
transport = transport-udp
context = from-cloudone
disallow = all
allow = ulaw
allow = alaw
allow = g729
outbound_auth = cloudone_auth
aors = cloudone_aor
; No from_user here — that would hardcode ONE static DID as the From-header
; identity for every outbound call through this trunk, regardless of which
; workspace placed it. Leaving it unset makes Asterisk use the channel's own
; CALLERID(num) instead, which [from-internal] already sets per-workspace
; (via each agent endpoint's set_var=DID=... in pjsip_workspaces.conf) right
; before Dial(). from_domain stays — that's just Cloud One's own SIP host,
; the same for every workspace.
from_domain = ${CLOUDONE_SIP_HOST}
dtmf_mode = rfc4733
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes
direct_media = no

[cloudone_identify]
type = identify
endpoint = cloudone
match = ${CLOUDONE_SIP_HOST}

;--- ElevenLabs Conversational AI agent -------------------------------
; Outbound-only for now (us -> them): a call reaches the agent by dialing
; PJSIP/${ELEVENLABS_SIP_USER}@elevenlabs from the dialplan. No registration
; (their SIP trunk doesn't use one) — outbound_auth answers their digest
; challenge with the username/password entered as this phone number's
; "Authentication" on their side. Calls FROM ElevenLabs back to us (needed
; for the agent to place outbound calls) are a separate piece, not wired
; yet — see asterisk/README.md before building that direction.
[elevenlabs_auth]
type = auth
auth_type = userpass
username = ${ELEVENLABS_SIP_AUTH_USER}
password = ${ELEVENLABS_SIP_AUTH_PASSWORD}

[elevenlabs_aor]
type = aor
contact = sip:${ELEVENLABS_SIP_HOST}:5060

[elevenlabs]
type = endpoint
transport = transport-tcp
context = from-internal
disallow = all
allow = ulaw
allow = alaw
outbound_auth = elevenlabs_auth
aors = elevenlabs_aor
from_user = ${ELEVENLABS_SIP_USER}
from_domain = ${ELEVENLABS_SIP_HOST}
dtmf_mode = rfc4733
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes
direct_media = no

;--- Agent softphones (WebRTC), one per workspace ----------------------
; Multi-tenant: every agent's endpoint/aor/auth block lives in
; pjsip_workspaces.conf, generated + kept in sync by the host script
; asterisk/sync_workspaces.py from telephony_configs / call_agents (a DID
; + SIP extension assigned in super admin). Never hand-edited; never
; overwritten by install-on-host.sh once it exists — see that script's
; comments. Each endpoint there carries the G.711-only / webrtc=yes config
; that used to be static here, plus set_var=DID=... / set_var=MYEXT=...
; consumed by extensions.conf.template.
#include pjsip_workspaces.conf
